# Append these entries to the .env beside your existing wger Compose file.
# This is the Hevy API key and your wger user's legacy API token.
HEVY_API_KEY=
HEVY_WGER_TOKEN=
# Internal wger service name and container port, not the published host port.
HEVY_WGER_BASE_URL=http://web:8000
HEVY_CONNECTOR_VERSION=0.1.0
HEVY_SYNC_POLICY=update_preserve_deleted
HEVY_SYNC_INTERVAL_SECONDS=900
